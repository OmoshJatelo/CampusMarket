<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/createMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sell an Item"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editProductTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Item Name (e.g., Mini Fridge)"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/editProductPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Price (e.g., KSh 4,500)"
        android:inputType="text" />

    <EditText
        android:id="@+id/editProductLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Location (e.g., Hall 6)"
        android:inputType="textCapWords" />

    <EditText
        android:id="@+id/editSellerPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="WhatsApp Number (e.g., +254700000000)"
        android:inputType="phone" />

    <Button
        android:id="@+id/btnSubmitListing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:padding="12dp"
        android:text="Submit Listing" />

</LinearLayout>